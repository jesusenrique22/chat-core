# Copia este archivo a .env o .env.local y completa los valores.
# En Render, estás variables deben configurarse en "Environment Variables" del Web Service.
# El backend NO arranca si faltan las variables marcadas como [OBLIGATORIA].

PORT=4000

# --- Obligatorias (sin defaults en runtime) ---
# [OBLIGATORIA] URI de conexión a MongoDB Atlas o DigitalOcean
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/chat_multiservicio?tls=true

# [OBLIGATORIA] true | false (En Render usar CORS_ALLOW_LAN=false)
CORS_ALLOW_LAN=false

# [OBLIGATORIA] true | false (Si es false, puedes especificar orígenes en CORS_EXTRA_ORIGINS)
CORS_ALLOW_ALL=true

# Orígenes CORS adicionales (soporta wildcard '*.onrender.com' para servicios de Render)
# CORS_EXTRA_ORIGINS=https://ticketsotravez-1.onrender.com,*.onrender.com

# [OBLIGATORIA] Bucket de almacenamiento de imágenes
BUCKET_UPLOAD_URL=https://api-bucket.smart.com.ve/api/imau/upload
BUCKET_API_KEY=1093cfbc5214591fb67ae2556ed61bc1222cf40dd34fbc8346f6a183537937302d3ab7a1079eadc13b02ac6d364b02a0c4172049e7bba43f44cd77740ef12d81
BUCKET_FOLDER=ticket_chat

# [OBLIGATORIA] Notificaciones -> Sistema de Tickets en Render
NOTIFICATIONS_API_URL=https://ticketsotravez-1.onrender.com/notifications/ticket
NOTIFICATIONS_API_KEY=tickets_secret_key_2026

# --- Opcionales ---
# En Render: TRUST_PROXY_HOPS=1 para que express-rate-limit obtenga la IP real del cliente detrás del proxy
TRUST_PROXY_HOPS=1
# LOG_LEVEL=info
# PUBLIC_BASE_URL=https://chat-core.onrender.com

# UPLOAD_MAX_BYTES=3145728
# JOIN_CHAT_MESSAGE_LIMIT=50
# CORS_CACHE_TTL_MS=300000
# SEND_MESSAGE_MAX_PER_MIN=10
# RATE_LIMIT_INTEGRATIONS=100
# RATE_LIMIT_CONVERSATIONS=60
# RATE_LIMIT_UPLOADS=20
# SOCKET_RECOVERY_MS=30000

# Mongo pool / timeouts (prod defaults: pool 20, selection 10s, socket 45s)
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=2
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_CONNECT_TIMEOUT_MS=10000

# Grace period al apagar (SIGTERM en Render), ms
# SHUTDOWN_TIMEOUT_MS=7000
