# Copia a .env / .env.local, o configura estas variables en Railway → Variables.
# El backend NO arranca si faltan las [OBLIGATORIA].

# Railway inyecta PORT automáticamente. En local puedes fijarlo:
PORT=4000

# --- Obligatorias ---
# [OBLIGATORIA] MongoDB Atlas / DigitalOcean
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/chat_multiservicio?tls=true

# [OBLIGATORIA] En Railway: CORS_ALLOW_LAN=false
CORS_ALLOW_LAN=false

# [OBLIGATORIA] true abre todos los orígenes (útil al subir). En prod: false + CORS_EXTRA_ORIGINS
CORS_ALLOW_ALL=true

# Orígenes extra (wildcards OK). Incluye la URL del Sistema de Tickets en Railway.
# CORS_EXTRA_ORIGINS=https://TU-TICKETS.up.railway.app,*.up.railway.app

# [OBLIGATORIA] Bucket de imágenes de tickets
BUCKET_UPLOAD_URL=https://api-bucket.smart.com.ve/api/imau/upload
BUCKET_API_KEY=tu_bucket_api_key
BUCKET_FOLDER=ticket_chat

# [OBLIGATORIA] Webhook saliente → Sistema de Tickets (Railway)
# Usa la URL pública de tickets + /notifications/ticket
NOTIFICATIONS_API_URL=https://ticketsotravez-production-43fd.up.railway.app/notifications/ticket
NOTIFICATIONS_API_KEY=tickets_secret_key_2026

# Orígenes extra (wildcards OK)
# CORS_EXTRA_ORIGINS=https://ticketsotravez-production-43fd.up.railway.app,*.up.railway.app

# --- Opcionales / Railway ---
# Detrás del proxy de Railway
TRUST_PROXY_HOPS=1

# URL pública de ESTE servicio (chat-core). Si no la pones, se usa RAILWAY_PUBLIC_DOMAIN.
# PUBLIC_BASE_URL=https://TU-CHAT-CORE.up.railway.app

# API key de Maracaibo (solo para auto-seed de plataformas en Mongo vacío)
# MARACAIBO_API_KEY=maracaibo_secret_key_2026

# LOG_LEVEL=info
# UPLOAD_MAX_BYTES=3145728
# JOIN_CHAT_MESSAGE_LIMIT=50
# CORS_CACHE_TTL_MS=300000
# SEND_MESSAGE_MAX_PER_MIN=10
# RATE_LIMIT_INTEGRATIONS=100
# RATE_LIMIT_CONVERSATIONS=60
# RATE_LIMIT_UPLOADS=20
# SOCKET_RECOVERY_MS=30000
# SHUTDOWN_TIMEOUT_MS=7000

# --- Seguridad (nuevo) ---
# true = exige API Key en /agent (socket), /api/conversations y rutas de citas.
#   · Agentes (/agent, bandeja y respuesta de citas): key de "Sistema de Tickets" o AGENT_API_KEYS
#   · Ciudadanos (crear/consultar citas): key de cualquier plataforma
#   · Un ciudadano no puede unirse al ticket de OTRO customerId
# false (default) = compatibilidad con frontends que aún no envían la key.
AUTH_ENFORCE=false
# Keys extra para el panel de agentes (separadas por coma). Socket: io('/agent', { auth: { apiKey } })
# AGENT_API_KEYS=
# Opcional: el socket /client debe enviar auth.token = HMAC-SHA256(secret, "customerId:ticketId")
# (lo genera el backend de Maracaibo; así nadie puede suplantar a otro ciudadano)
# CLIENT_TOKEN_SECRET=

# --- Escalabilidad (nuevo) ---
# Con REDIS_URL, Socket.io comparte salas/eventos entre instancias (PM2 cluster / réplicas).
# Sin Redis ejecuta UNA sola instancia.
# REDIS_URL=redis://default:pass@host:6379

# --- Webhooks salientes (cola persistente con reintentos) ---
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_MAX_ATTEMPTS=8
# WEBHOOK_CONCURRENCY=5

# --- Límites (nuevo) ---
# AGENT_SEND_MESSAGE_MAX_PER_MIN=120
# RATE_LIMIT_APPOINTMENTS_CREATE=10
# RATE_LIMIT_APPOINTMENTS_LOOKUP=60
# JSON_BODY_LIMIT=256kb
# SOCKET_MAX_BUFFER_BYTES=262144
# BUCKET_TIMEOUT_MS=15000

# ─── Llamadas de voz (WebRTC) ───
# TURN de Cloudflare Realtime: sin estas variables solo se usa STUN (falla en algunas redes móviles).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Opcionales
# CALL_RING_TIMEOUT_MS=45000        # sin respuesta → llamada perdida
# CALL_DISCONNECT_GRACE_MS=30000    # tiempo para reconectar el socket sin cortar la llamada
# CALL_ICE_TTL_SECONDS=14400        # vigencia de las credenciales TURN

# ─── Push de llamadas (Servicios Maracaibo): suena con la app cerrada ───
# POST {CALLS_PUSH_URL} con x-internal-key. Sin estas variables no se envía push.
CALLS_PUSH_URL=
CALLS_PUSH_KEY=
